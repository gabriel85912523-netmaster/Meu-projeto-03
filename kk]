
<!DOCTYPE html>
<html lang="pt-BR">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>GTA VI — Vice City</title>

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

    <link
        href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Poppins:wght@300;400;500;600;700&display=swap"
        rel="stylesheet"
    >

    <!-- CSS -->
    <link rel="stylesheet" href="style.css">
</head>

<body>

    <!-- ================= HEADER ================= -->

    <header class="header">

        <a href="#home" class="logo">
            GTA <span>VI</span>
        </a>

        <nav class="navbar">
            <a href="#home">Início</a>
            <a href="#about">O Jogo</a>
            <a href="#features">Recursos</a>
            <a href="#vice-city">Vice City</a>
        </nav>

        <a href="#about" class="header-button">
            EXPLORAR
        </a>

    </header>


    <!-- ================= HERO ================= -->

    <main>

        <section class="hero" id="home">

            <div class="hero-background"></div>

            <div class="hero-content">

                <p class="hero-small">
                    WELCOME TO
                </p>

                <h1>
                    VICE
                    <span>CITY</span>
                </h1>

                <div class="hero-line"></div>

                <p class="hero-description">
                    Uma nova era está chegando.
                    Explore uma cidade vibrante, perigosa
                    e cheia de histórias.
                </p>

                <div class="hero-buttons">

                    <a href="#about" class="button button-primary">
                        EXPLORAR AGORA
                    </a>

                    <a href="#vice-city" class="button button-outline">
                        CONHECER VICE CITY
                    </a>

                </div>

            </div>

            <div class="scroll-indicator">
                <span></span>
                SCROLL
            </div>

        </section>


        <!-- ================= ABOUT ================= -->

        <section class="about" id="about">

            <div class="section-heading">

                <p class="section-label">
                    THE NEXT CHAPTER
                </p>

                <h2>
                    UMA NOVA
                    <span>EXPERIÊNCIA</span>
                </h2>

                <p>
                    Prepare-se para retornar a Vice City em uma aventura
                    ambientada em um enorme mundo aberto inspirado no
                    sul da Flórida.
                </p>

            </div>


            <div class="cards" id="features">

                <article class="card">

                    <div class="card-number">
                        01
                    </div>

                    <div class="card-icon">
                        🌴
                    </div>

                    <h3>
                        VICE CITY
                    </h3>

                    <p>
                        Praias ensolaradas, ruas movimentadas,
                        clubes noturnos e lugares secretos.
                    </p>

                    <a href="#vice-city">
                        DESCUBRA →
                    </a>

                </article>


                <article class="card">

                    <div class="card-number">
                        02
                    </div>

                    <div class="card-icon">
                        🚘
                    </div>

                    <h3>
                        MUNDO ABERTO
                    </h3>

                    <p>
                        Explore diferentes regiões e descubra
                        novas possibilidades em cada esquina.
                    </p>

                    <a href="#vice-city">
                        EXPLORAR →
                    </a>

                </article>


                <article class="card">

                    <div class="card-number">
                        03
                    </div>

                    <div class="card-icon">
                        🎬
                    </div>

                    <h3>
                        NOVA HISTÓRIA
                    </h3>

                    <p>
                        Personagens marcantes, conflitos,
                        perseguições e uma nova narrativa.
                    </p>

                    <a href="#vice-city">
                        SABER MAIS →
                    </a>

                </article>

            </div>

        </section>


        <!-- ================= VICE CITY ================= -->

        <section class="city" id="vice-city">

            <div class="city-overlay"></div>

            <div class="city-content">

                <p class="section-label">
                    WELCOME BACK
                </p>

                <h2>
                    VICE
                    <span>CITY</span>
                </h2>

                <p>
                    Neon durante a noite.
                    Sol durante o dia.
                    Uma cidade onde cada esquina pode
                    esconder uma nova história.
                </p>

                <a href="#home" class="button button-primary">
                    VOLTAR AO TOPO
                </a>

            </div>

        </section>


        <!-- ================= CTA ================= -->

        <section class="cta">

            <p class="section-label">
                THE CITY IS WAITING
            </p>

            <h2>
                VOCÊ ESTÁ
                <span>PREPARADO?</span>
            </h2>

            <a href="#home" class="button button-primary">
                ENTRAR EM VICE CITY
            </a>

        </section>

    </main>


    <!-- ================= FOOTER ================= -->

    <footer class="footer">

        <div class="footer-logo">
            GTA <span>VI</span>
        </div>

        <p>
            © 2026 — MEUS GAMES
        </p>

        <p class="copyright">
            Projeto de fã — não oficial.
        </p>

    </footer>

</body>

</html>